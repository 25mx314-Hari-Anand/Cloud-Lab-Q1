{
  "name": "online-book-store",
  "version": "1.0.0",
  "description": "Online Book Store Web Application with Node.js, Express, and MongoDB Atlas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "bookstore",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "cloud-lab"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testTimeout": 10000,
    "moduleNameMapper": {
      "^.*models/Book$": "<rootDir>/tests/mockBook.js",
      "^.*models/Order$": "<rootDir>/tests/mockOrder.js"
    }
  }
}
